# Normalização de fim de linha
# O repositório sempre armazena LF. Trabalho feito no Windows (CRLF) ou
# Linux (LF) é normalizado automaticamente no commit e não gera diff falso.
* text=auto

# Código-fonte do servidor (compila no Linux): sempre LF
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.hxx text eol=lf

# Scripts e arquivos que rodam no Linux: sempre LF
*.sh text eol=lf
Makefile text eol=lf
*.lua text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.dockerfile text eol=lf

# Batch do Windows: manter CRLF
*.bat text eol=crlf

# Binários: nunca converter
*.gz binary
*.tgz binary
*.tar binary
*.zip binary
*.luac binary
